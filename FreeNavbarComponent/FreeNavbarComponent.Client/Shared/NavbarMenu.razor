@using System.ComponentModel
@implements IDisposable
@inject Microsoft.JSInterop.IJSRuntime jsRuntime

@*
    A multi-level nested navbar menu built entirely from Bootstrap classes.

    Bootstrap has no multi-level dropdown, so the submenus are nested .accordion
    blocks inside one ordinary .dropdown-menu. Bootstrap's collapse data API opens
    each branch, writes aria-expanded back to the button and rotates the chevron,
    so the menu itself needs no JavaScript at all. The companion .js module only
    supplies the optional search filter.

    Two attributes carry the whole design:
      data-bs-auto-close="outside"  keeps the panel open while you drill in
      data-bs-theme="light"         stops the navbar dark scheme cascading in

    bootstrap.bundle.min.js is already loaded globally by App.razor, so unlike the
    Highcharts component there are no external resources to load here.
*@

<style>
    /* Phone-width handling. The desktop panel anchors to its toggle, but on a
       narrow screen the toggle sits mid-viewport and the panel's min-width would
       push it off the edge. Bootstrap's own answer (the collapsed hamburger mode)
       makes dropdowns static and full width; since this navbar never collapses,
       the same effect is recreated here: the .nav-item stops being the positioning
       context, so the panel positions against the navbar itself and spans the
       viewport with a small inset. !important is required because the width
       limits it overrides arrive via the MenuStyle inline style. */
    @@media (max-width: 575.98px) {
        .free-navbar-menu .navbar-nav {
            flex-wrap: wrap;
        }

        .free-navbar-menu .nav-item.dropdown,
        .free-navbar-menu .nav-item.dropup {
            position: static;
        }

        .free-navbar-menu .dropdown-menu {
            left: 0.5rem;
            right: 0.5rem;
            width: auto;
            min-width: 0 !important;
            max-width: none !important;
            /* dvh tracks the real visible height around mobile browser chrome;
               the offset leaves room for the navbar row above the panel. */
            max-height: min(70vh, calc(100dvh - 7rem)) !important;
        }
    }

    /* Bootstrap's dark-navbar link colour is 55% white, which fails WCAG AA
       contrast (3.1:1) on saturated brand backgrounds. Raise it so the toggle
       and links read at 4.5:1+ on any dark or brand colour. */
    .free-navbar-menu[data-bs-theme="dark"] {
        --bs-navbar-color: rgba(255, 255, 255, .9);
        --bs-navbar-hover-color: #fff;
        --bs-navbar-active-color: #fff;
        --bs-navbar-disabled-color: rgba(255, 255, 255, .6);
    }

    /* Branch rows dress as dropdown items, not accordions: same padding, colors,
       and hover as .dropdown-item, driven by Bootstrap's own dropdown CSS
       variables so they match the stock items in every theme. Only the chevron
       marks a row as expandable. */
    .free-navbar-menu .dropdown-menu .accordion,
    .free-navbar-menu .dropdown-menu .accordion-item {
        background-color: transparent;
        border: 0;
    }

    .free-navbar-menu .dropdown-menu .accordion-button {
        padding: var(--bs-dropdown-item-padding-y, .25rem) var(--bs-dropdown-item-padding-x, 1rem);
        font-size: inherit;
        font-weight: 400;
        color: var(--bs-dropdown-link-color);
        background-color: transparent;
        border: 0;
        border-radius: 0;
        box-shadow: none;
    }

    .free-navbar-menu .dropdown-menu .accordion-button:hover {
        color: var(--bs-dropdown-link-hover-color);
        background-color: var(--bs-dropdown-link-hover-bg);
    }

    /* Drop the accordion's mouse-click glow, but keep a visible ring for
       keyboard focus (WCAG 2.4.7): :focus-visible only fires for keyboard/AT
       focus, so pointer users see the plain hover style. */
    .free-navbar-menu .dropdown-menu .accordion-button:focus:not(:focus-visible) {
        box-shadow: none;
    }

    .free-navbar-menu .dropdown-menu .accordion-button:focus-visible {
        outline: 2px solid var(--bs-focus-ring-color, rgba(13, 110, 253, .5));
        outline-offset: -2px;
        box-shadow: none;
    }

    .free-navbar-menu .dropdown-menu .accordion-button:not(.collapsed) {
        color: var(--bs-dropdown-link-color);
        background-color: transparent;
        box-shadow: none;
    }

    .free-navbar-menu .dropdown-menu .accordion-button::after {
        width: 1rem;
        height: 1rem;
        background-size: 1rem;
    }

    /* The search filter hides a leaf by putting .d-none on the link itself, so
       the list item wrapping it has to go too or a filtered result set is spaced
       out by the rows it removed. */
    .free-navbar-menu .dropdown-menu li:has(> .dropdown-item.d-none) {
        display: none;
    }
</style>

@* sticky-top brings z-index:1020 and a stacking context per navbar, which is
   right for a page's single pinned navbar but wrong for an in-page instance:
   two stacked instances would paint the later navbar over the earlier one's
   open panel. Sticky="false" drops it for embedded use. *@
<nav id="@_navId" class="navbar navbar-expand @(Sticky ? "sticky-top" : "") shadow-sm free-navbar-menu @Class"
     data-bs-theme="@Theme" aria-label="@NavLabel"
     style="@(!String.IsNullOrWhiteSpace(BrandColor) ? "background: " + BrandColor : "")">
    <div class="@ContainerClass">
        @if (!BrandEnd && !String.IsNullOrWhiteSpace(BrandText)) {
            <a class="navbar-brand fw-bold" href="@(!String.IsNullOrWhiteSpace(BrandUrl) ? BrandUrl : "#")">@BrandText</a>
        }

        @* me-auto pushes the links left; ms-auto pushes them to the right edge.
           AlignEnd implies right-side links; AlignLinksEnd places them there
           without pinning the panel, letting AutoAlign handle the panel side. *@
        <ul class="navbar-nav @(AlignEnd || AlignLinksEnd ? "ms-auto" : "me-auto")">
            @if (LeadingItems != null) {
                @foreach (var item in LeadingItems) {
                    <li class="nav-item">
                        <a class="nav-link @(item.Active ? "active" : "") @(item.Disabled ? "disabled" : "")"
                           @attributes="LinkAttributes(item)"
                           href="@(!String.IsNullOrWhiteSpace(item.Url) ? item.Url : "#")"
                           @onclick="@(() => LeafClicked(item))"
                           @onclick:preventDefault="@(String.IsNullOrWhiteSpace(item.Url))">@ItemIcon(item)@item.Text</a>
                    </li>
                }
            }

            @if (Value != null && Value.Any()) {
                @* dropup makes Bootstrap open the panel above the toggle (and
                   flips the caret), which is what keeps the panel on screen
                   when the navbar sits at the bottom of the page. *@
                <li class="nav-item @(DropUp ? "dropup" : "dropdown")">
                    <a class="nav-link dropdown-toggle" href="#" role="button"
                       data-bs-toggle="dropdown" data-bs-auto-close="outside"
                       aria-expanded="false">@MenuText</a>

                    @* Bootstrap positions navbar dropdowns statically, so Popper's
                       collision detection never runs and a left-anchored panel can
                       hang off the right edge of the window. .dropdown-menu-end
                       anchors it to the toggle's right instead, which is what keeps
                       a menu near the edge on screen. *@
                    <div class="dropdown-menu p-0 shadow overflow-auto @(AlignEnd ? "dropdown-menu-end" : "") @MenuClass"
                         style="@MenuStyle" data-bs-theme="light">

                        @* A div, not Bootstrap's default h6: the panel caption is a
                           label, and an h6 straight after the page's h1 breaks the
                           heading order for assistive tech. *@
                        @if (!String.IsNullOrWhiteSpace(MenuHeader)) {
                            <div class="dropdown-header">@MenuHeader</div>
                        }

                        @if (ShowSearch) {
                            <div class="p-2 border-bottom">
                                <label class="visually-hidden" for="@_searchId">@SearchLabel</label>
                                <input type="search" class="form-control form-control-sm" id="@_searchId"
                                       placeholder="@SearchPlaceholderText" aria-controls="@_treeId" autocomplete="off" />
                            </div>
                        }

                        @* A real list, not a stack of divs: it is what tells a
                           screen reader "list, 4 items" on the way in and gives
                           each row its position within the group. aria-setsize
                           and aria-posinset cannot do that job here - they are
                           not allowed on button or link roles, and browsers
                           discard them - so native list markup is the mechanism.
                           role="list" is spelled out because list-style: none
                           makes WebKit drop list semantics otherwise. *@
                        <ul class="accordion accordion-flush list-unstyled mb-0" role="list" id="@_treeId">
                            @foreach (var item in Value) {
                                @RenderBranch(item, 1)
                            }
                        </ul>

                        @if (ShowFooterCount) {
                            <hr class="dropdown-divider" />
                            <span class="dropdown-item-text small text-secondary" role="status"
                                  aria-live="polite" id="@_countId">@FooterText()</span>
                        }
                    </div>
                </li>
            }

            @if (TrailingItems != null) {
                @foreach (var item in TrailingItems) {
                    <li class="nav-item">
                        <a class="nav-link @(item.Active ? "active" : "") @(item.Disabled ? "disabled" : "")"
                           @attributes="LinkAttributes(item)"
                           href="@(!String.IsNullOrWhiteSpace(item.Url) ? item.Url : "#")"
                           @onclick="@(() => LeafClicked(item))"
                           @onclick:preventDefault="@(String.IsNullOrWhiteSpace(item.Url))">@ItemIcon(item)@item.Text</a>
                    </li>
                }
            }
        </ul>

        @if (BrandEnd && !String.IsNullOrWhiteSpace(BrandText)) {
            <a class="navbar-brand fw-bold ms-2 me-0" href="@(!String.IsNullOrWhiteSpace(BrandUrl) ? BrandUrl : "#")">@BrandText</a>
        }

        @ChildContent
    </div>
</nav>

@code {
    // Every row is a list item: a branch is an .accordion-item, a leaf wraps a
    // plain .dropdown-item. Each level is one list containing both, so the group
    // a row belongs to - and how big it is - is exposed to assistive tech.
    // The heading level tracks the nesting depth (h2..h6) so the menu keeps a sane
    // document outline no matter how deep the tree goes, matching the source design.
    private RenderFragment RenderBranch(NavbarMenuItem item, int depth) => __builder =>
    {
        if (item.HasChildren) {
            string bodyId = ElementIdFor(item);

            @* role=heading with aria-level instead of an <hN> tag: a MarkupString
               open tag cannot wrap Blazor content (the HTML parser closes it
               immediately, orphaning the button beside an empty heading), and a
               div with aria-level carries the same semantics at any depth. *@
            <li class="accordion-item">
                <div role="heading" aria-level="@Math.Min(depth + 1, 6)" class="accordion-header">
                    <button class="accordion-button collapsed" type="button"
                            data-bs-toggle="collapse" data-bs-target="@("#" + bodyId)"
                            aria-expanded="false" aria-controls="@bodyId">@ItemIcon(item)@item.Text</button>
                </div>

                <div class="accordion-collapse collapse" id="@bodyId">
                    <div class="accordion-body p-0 ps-3">
                        @* One list per level, holding this level's branches and
                           leaves together, so the announced group size is the
                           number of choices actually on offer here. Nested
                           branches come first so deeper structure stays above
                           the plain links. *@
                        <ul class="accordion accordion-flush list-unstyled mb-0" role="list">
                            @foreach (var child in item.Children!.Where(x => x.HasChildren)) {
                                @RenderBranch(child, depth + 1)
                            }

                            @foreach (var child in item.Children!.Where(x => !x.HasChildren)) {
                                @RenderBranch(child, depth + 1)
                            }
                        </ul>
                    </div>
                </div>
            </li>
        } else {
            <li>
                <a class="dropdown-item @(item.Disabled ? "disabled" : "")"
                   @attributes="LinkAttributes(item)"
                   href="@(!String.IsNullOrWhiteSpace(item.Url) ? item.Url : "#")"
                   @onclick="@(() => LeafClicked(item))"
                   @onclick:preventDefault="@(String.IsNullOrWhiteSpace(item.Url))">@ItemIcon(item)@item.Text</a>
            </li>
        }
    };

    /// <summary>
    /// Right-aligns the dropdown panel to its toggle (Bootstrap's
    /// .dropdown-menu-end). Set this when the menu sits near the right edge of the
    /// window: Bootstrap positions navbar dropdowns statically, so Popper's
    /// collision detection never runs and a left-anchored panel would hang off the
    /// edge and force the page to scroll sideways. With AutoAlign on (the
    /// default), setting this manually is rarely needed.
    /// </summary>
    [Parameter] public bool AlignEnd { get; set; }

    /// <summary>
    /// Places the nav links at the right edge of the navbar without pinning the
    /// panel's alignment, leaving AutoAlign to pick the panel side. AlignEnd
    /// implies this.
    /// </summary>
    [Parameter] public bool AlignLinksEnd { get; set; }

    /// <summary>
    /// Automatically keeps the panel on screen. On each open the painted panel is
    /// measured, and its alignment flips to whichever side has enough room, so a
    /// menu near either screen edge never renders off-screen. On by default;
    /// ignored when AlignEnd is set explicitly.
    /// </summary>
    [Parameter] public bool AutoAlign { get; set; } = true;

    /// <summary>
    /// The brand colour applied to the navbar background. Bootstrap has no
    /// arbitrary background utility, so this is emitted as an inline style.
    /// </summary>
    [Parameter] public string? BrandColor { get; set; }

    /// <summary>
    /// The brand label at the left of the navbar. Omit to hide it.
    /// </summary>
    [Parameter] public string? BrandText { get; set; }

    /// <summary>
    /// Where the brand label links to. Defaults to "#".
    /// </summary>
    [Parameter] public string? BrandUrl { get; set; }

    /// <summary>
    /// Rendered at the end of the navbar container, for anything the parent page
    /// wants to place alongside the menu.
    /// </summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Extra CSS classes for the navbar element.
    /// </summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// The class applied to the navbar's inner container. Use "container-fluid"
    /// for a full-width bar.
    /// </summary>
    [Parameter] public string ContainerClass { get; set; } = "container";

    /// <summary>
    /// Optional stable prefix for generated element ids. Supply this when more than
    /// one menu is on the page and you need predictable ids; otherwise a unique
    /// prefix is generated per instance.
    /// </summary>
    [Parameter] public string Id { get; set; } = String.Empty;

    /// <summary>
    /// Plain nav links rendered before the dropdown.
    /// </summary>
    [Parameter] public List<NavbarMenuItem>? LeadingItems { get; set; }

    /// <summary>
    /// Extra CSS classes for the dropdown panel.
    /// </summary>
    [Parameter] public string? MenuClass { get; set; }

    /// <summary>
    /// An optional heading shown at the top of the dropdown panel.
    /// </summary>
    [Parameter] public string? MenuHeader { get; set; }

    /// <summary>
    /// Inline style for the dropdown panel. The panel is .overflow-auto, so the
    /// max-height is what makes a long tree scroll rather than run off the bottom
    /// of the window, and the max-width stops a deeply indented tree growing the
    /// panel wider than the viewport.
    /// </summary>
    [Parameter] public string MenuStyle { get; set; }
        = "max-height: 70vh; min-width: 20rem; max-width: min(92vw, 40rem);";

    /// <summary>
    /// The label on the dropdown toggle.
    /// </summary>
    [Parameter] public string MenuText { get; set; } = "Menu";

    /// <summary>
    /// Raised when the search filter runs, with the query and the number of
    /// matching leaves. Receives a NavbarFilterResult.
    /// </summary>
    [Parameter] public Delegate? OnFilter { get; set; }

    /// <summary>
    /// Raised when a leaf item is clicked. Receives the NavbarMenuItem.
    /// Items with a Url navigate normally and this still fires; items without one
    /// only raise the event.
    /// </summary>
    [Parameter] public Delegate? OnItemClicked { get; set; }

    /// <summary>
    /// Raised when the menu tree changes. Receives the List of NavbarMenuItem.
    /// </summary>
    [Parameter] public Delegate? OnValueChanged { get; set; }

    /// <summary>
    /// The text for the search box's visually hidden label.
    /// </summary>
    [Parameter] public string SearchLabel { get; set; } = "Search";

    /// <summary>
    /// Placeholder text shown in the search box.
    /// </summary>
    [Parameter] public string SearchPlaceholderText { get; set; } = "Search";

    /// <summary>
    /// Shows the live-region count line beneath the tree.
    /// </summary>
    [Parameter] public bool ShowFooterCount { get; set; } = true;

    /// <summary>
    /// Renders the brand after the nav links instead of before them, so the
    /// menu toggle sits at the navbar's leading edge. Useful when the menu
    /// must hug the edge of the screen and the brand is just a label.
    /// </summary>
    [Parameter] public bool BrandEnd { get; set; } = false;

    /// <summary>
    /// Opens the panel upward instead of downward (Bootstrap's dropup), and
    /// flips the toggle's caret to match. Use for a navbar placed at the
    /// bottom of the screen or page, where a downward panel would run off the
    /// bottom edge. Off by default.
    /// </summary>
    [Parameter] public bool DropUp { get; set; } = false;

    /// <summary>
    /// Shows the search box. Set false to drop it and its JS wiring.
    /// </summary>
    [Parameter] public bool ShowSearch { get; set; } = true;

    /// <summary>
    /// Pins the navbar to the top of the viewport while the page scrolls
    /// (Bootstrap's sticky-top). On by default. Set false when the navbar is
    /// embedded in page content — especially with more than one instance on a
    /// page, where sticky-top's per-navbar stacking context would paint a later
    /// navbar over an earlier one's open panel.
    /// </summary>
    [Parameter] public bool Sticky { get; set; } = true;

    /// <summary>
    /// The Bootstrap colour scheme for the navbar itself ("dark" or "light").
    /// The dropdown panel is always pinned to "light" so the navbar's scheme does
    /// not cascade into the menu.
    /// </summary>
    [Parameter] public string Theme { get; set; } = "dark";

    /// <summary>
    /// Accessible name for the navigation landmark, so screen readers can tell
    /// this navbar apart from others on the page. Defaults to BrandText, then
    /// MenuText.
    /// </summary>
    [Parameter] public string? AriaLabel { get; set; }

    protected string NavLabel {
        get {
            if (!String.IsNullOrWhiteSpace(AriaLabel)) { return AriaLabel; }
            if (!String.IsNullOrWhiteSpace(BrandText)) { return BrandText; }
            return MenuText;
        }
    }

    /// <summary>
    /// Plain nav links rendered after the dropdown.
    /// </summary>
    [Parameter] public List<NavbarMenuItem>? TrailingItems { get; set; }

    /// <summary>
    /// The nested menu tree. Any depth is supported.
    /// </summary>
    [Parameter] public List<NavbarMenuItem> Value { get; set; } = new List<NavbarMenuItem>();

    /// <summary>
    /// Supports two-way binding with @bind-Value.
    /// </summary>
    [Parameter] public EventCallback<List<NavbarMenuItem>> ValueChanged { get; set; }

    protected string _countId = String.Empty;
    protected bool _disposed = false;
    protected string _idPrefix = String.Empty;
    protected int _leafCount = 0;
    protected int _levelCount = 0;
    protected string _navId = String.Empty;
    protected string _renderedSignature = String.Empty;
    protected string _searchId = String.Empty;
    protected string _treeId = String.Empty;

    protected DotNetObjectReference<NavbarMenu>? dotNetHelper;
    protected IJSObjectReference? jsModule;

    // Ids are assigned per item so the collapse targets stay stable across renders.
    protected Dictionary<NavbarMenuItem, string> _elementIds = new();
    protected int _idCounter = 0;
    protected List<NavbarMenuItem>? _lastValue;

    public void Dispose()
    {
        _disposed = true;
        dotNetHelper?.Dispose();
    }

    protected string ElementIdFor(NavbarMenuItem item)
    {
        if (!_elementIds.TryGetValue(item, out var id)) {
            _idCounter++;
            id = _idPrefix + "-b" + _idCounter.ToString();
            _elementIds.Add(item, id);
        }

        return id;
    }

    protected string FooterText()
    {
        string products = _leafCount == 1 ? "product" : "products";
        string levels = _levelCount == 1 ? "level" : "levels";
        return $"{_leafCount} {products} across {_levelCount} {levels}";
    }

    protected Dictionary<string, object> LinkAttributes(NavbarMenuItem item)
    {
        var output = new Dictionary<string, object>();

        if (item.Disabled) {
            output.Add("aria-disabled", "true");
        }

        if (item.Active) {
            output.Add("aria-current", "page");
        }

        if (!String.IsNullOrWhiteSpace(item.Target)) {
            output.Add("target", item.Target);
        }

        return output;
    }

    protected void LeafClicked(NavbarMenuItem item)
    {
        if (item.Disabled) {
            return;
        }

        OnItemClicked?.DynamicInvoke(item);
    }

    protected override void OnInitialized()
    {
        _idPrefix = !String.IsNullOrWhiteSpace(Id)
            ? Id
            : "navmenu-" + Guid.NewGuid().ToString().Replace("-", "").Substring(0, 8);

        _navId = _idPrefix + "-nav";
        _searchId = _idPrefix + "-search";
        _treeId = _idPrefix + "-tree";
        _countId = _idPrefix + "-count";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // A page that redirects while this component is still loading (a login
        // redirect, for example) disposes it mid-await. Every await below is a
        // point where that can happen, so the disposed flag is re-checked after
        // each one before the JS interop objects are touched again.
        if (firstRender) {
            dotNetHelper = DotNetObjectReference.Create(this);

            IJSObjectReference module;

            try {
                module = await jsRuntime.InvokeAsync<IJSObjectReference>("import",
                    "./Shared/NavbarMenu.razor.js?v=" + Guid.NewGuid().ToString().Replace("-", ""));
            } catch (JSDisconnectedException) {
                return;
            } catch (ObjectDisposedException) {
                return;
            } catch (TaskCanceledException) {
                return;
            }

            if (_disposed) {
                // Nothing will use the module now, so release it rather than leak it.
                try {
                    await module.DisposeAsync();
                } catch { }
                return;
            }

            jsModule = module;

            if (!await SafeInvoke("SetDotNetHelper", dotNetHelper)) {
                return;
            }

            // Auto edge detection is skipped when the caller pinned the alignment
            // explicitly with AlignEnd.
            await SafeInvoke("InitializeEdgeGuard", _navId, AutoAlign && !AlignEnd);

            // Arrow-key movement through the tree. Tab order is unchanged; this
            // only adds the shortcuts a keyboard user expects from a menu.
            await SafeInvoke("InitializeKeyboard", _navId);
        }

        // Re-wire whenever the tree changes, so the filter always matches what is
        // on screen. Bootstrap itself needs no re-initialisation: the collapse and
        // dropdown behaviour is driven by data attributes on the rendered markup.
        if (jsModule != null && ShowSearch && _renderedSignature != CurrentSignature()) {
            _renderedSignature = CurrentSignature();
            await SafeInvoke("InitializeFilter", _searchId, _treeId,
                ShowFooterCount ? _countId : null, _levelCount);
        }
    }

    /// <summary>
    /// Invokes a JS module method, tolerating the component being torn down or the
    /// circuit going away mid-call. Returns false when the call did not complete.
    /// </summary>
    protected async Task<bool> SafeInvoke(string identifier, params object?[] args)
    {
        if (_disposed || jsModule == null) {
            return false;
        }

        try {
            await jsModule.InvokeVoidAsync(identifier, args);
            return true;
        } catch (JSDisconnectedException) {
        } catch (ObjectDisposedException) {
        } catch (TaskCanceledException) {
        }

        return false;
    }

    protected override void OnParametersSet()
    {
        // A page that rebuilds its tree each render supplies new item instances
        // every time; without eviction the id dictionary would grow one entry per
        // item per render for the life of the component.
        if (!ReferenceEquals(_lastValue, Value)) {
            _lastValue = Value;
            _elementIds.Clear();
        }

        _leafCount = CountLeaves(Value);
        _levelCount = MaxDepth(Value);
    }

    [JSInvokable]
    public void OnFilterChanged(string query, int matches)
    {
        OnFilter?.DynamicInvoke(new NavbarFilterResult {
            Matches = matches,
            Query = query
        });
    }

    /// <summary>
    /// Clears the search box and collapses every branch.
    /// </summary>
    public async Task Reset()
    {
        await SafeInvoke("ResetMenu", _searchId, _treeId,
            ShowFooterCount ? _countId : null, _levelCount);
    }

    protected int CountLeaves(List<NavbarMenuItem>? items)
    {
        if (items == null) {
            return 0;
        }

        int output = 0;

        foreach (var item in items) {
            if (item.HasChildren) {
                output += CountLeaves(item.Children);
            } else {
                output++;
            }
        }

        return output;
    }

    protected int MaxDepth(List<NavbarMenuItem>? items)
    {
        if (items == null || !items.Any()) {
            return 0;
        }

        int output = 0;

        foreach (var item in items) {
            int depth = item.HasChildren ? 1 + MaxDepth(item.Children) : 1;
            if (depth > output) {
                output = depth;
            }
        }

        return output;
    }

    // A cheap change token: the filter only needs re-wiring when the rendered tree
    // actually differs, not on every state change from the parent page.
    protected string CurrentSignature()
    {
        return _leafCount.ToString() + ":" + _levelCount.ToString() + ":" + _idCounter.ToString();
    }

    // NavbarMenuItem lives in its own file at namespace level so pages can write
    // new NavbarMenuItem { ... } without a component prefix.

    /// <summary>
    /// Renders an item's optional icon: a CSS class name becomes an <i> element,
    /// anything containing markup is emitted as-is.
    /// </summary>
    protected MarkupString ItemIcon(NavbarMenuItem item)
    {
        if (String.IsNullOrWhiteSpace(item.Icon)) {
            return (MarkupString)String.Empty;
        }

        string icon = item.Icon.Trim();

        if (!icon.StartsWith("<")) {
