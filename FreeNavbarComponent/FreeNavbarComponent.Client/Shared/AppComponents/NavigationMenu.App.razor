@implements IDisposable
@inject BlazorDataModel Model

<div>Custom Navigation Menu</div>

@code {
    // Set this to true to use this navigation menu instead of the default.
    // The default NavigationMenu renders nested menu items at any depth for both
    // the app menus and the Admin menu, so an override is only needed when an
    // app wants an entirely different bar.
    [Parameter] public bool Enabled { get; set; } = false;

    [Parameter] public bool Loading { get; set; }

    public void Dispose()
    {
        Model.OnChange -= StateHasChanged;
    }

    protected override void OnInitialized()
    {
        Model.OnChange += StateHasChanged;
    }
}
