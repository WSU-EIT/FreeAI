@implements IDisposable
@inject BlazorDataModel Model

@*
    Full replacement for the default navigation menu, rendered with the nested
    accordion mechanic from the NavbarMenu component: every dropdown - the app
    menus and Admin alike - goes through one recursive renderer, so any MenuItem
    tree renders at any depth. Bootstrap's collapse data API drives the branches
    (writing aria-expanded as it goes), and in the collapsed hamburger view the
    panels become static flow content, so the same markup works at every width.

    Enabled = true switches the app to this bar; set it false to fall back to
    the original single-level NavigationMenu.
*@

<header>
    <style>
        /* In the expanded navbar a nested panel needs its own scroll and a
           sensible width; in the collapsed (hamburger) view Bootstrap makes
           dropdowns static flow content and the page scrolls instead, so no
           constraints are wanted there. 992px matches navbar-expand-lg. */
        @@media (min-width: 992px) {
            header .nav-nested-menu {
                max-height: 70vh;
                overflow: auto;
                min-width: 20rem;
                max-width: min(92vw, 40rem);
            }
        }
    </style>
    <nav class="navbar fixed-top navbar-expand-lg navbar-expand-md border-bottom box-shadow mb-3">
        <div class="container-fluid">
            <a class="navbar-brand" href="@(Helpers.BuildUrl())">
                @{
                    string headerTitle = "<span>" + Helpers.Text("AppTitle").Replace("\"", "''") + "</span>";
                    @((MarkupString)headerTitle)
                }
            </a>
            <button id="menu-bar-toggler" class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navBarToggler" aria-controls="navbarSupportedContent"
            aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse" id="navBarToggler">
                <ul class="navbar-nav me-auto">
                    @if (Model.LoggedIn) {
                        foreach (var item in Helpers.MenuItems) {
                            @RenderRootItem(item)
                        }

                        @if (Helpers.MenuItemsAdmin.Any()) {
                            @* Admin renders through the same tree renderer as
                               everything else, as a synthesized root whose
                               children are the admin items - so admin entries
                               can nest too. *@
                            @RenderRootItem(new DataObjects.MenuItem {
                                Title = Helpers.Text("Admin"),
                                Icon = "Admin",
                                PageNames = new List<string>(),
                                Children = Helpers.MenuItemsAdmin,
                            }, Helpers.AdminView)
                        }
                    } else if (Model.Loaded) {
                        <li class="nav-item">
                            <a class="nav-link @(Model.View == "login" ? "active" : "")" href="@Helpers.BuildUrl("Login")">
                                <Language Tag="Login" IncludeIcon="true" />
                            </a>
                        </li>
                    }
                </ul>
                <form class="d-flex">
                    <ul class="navbar-nav me-auto">
                        @if (Model.HaveDeletedRecords) {
                            <li class="nav-item">
                                <a class="nav-link deleted-records" role="button" href="@(Helpers.BuildUrl("Settings/DeletedRecords"))" title="@Helpers.Text("PendingDeletedRecords")">
                                    <Icon Name="DeletedRecords" />
                                </a>
                            </li>
                        }

                        @if (String.IsNullOrWhiteSpace(Model.Tenant.TenantSettings.Theme)) {
                            <li class="nav-item dropdown" title="@Helpers.Text("Theme")">
                                <a class="nav-link dropdown-toggle" href="javascript:void('@Helpers.Text("Theme").Replace("'", "")');" id="themeDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="@Helpers.Text("SelectTheme")">
                                    @switch (Model.User.UserPreferences.Theme) {
                                        case "dark":
                                            <Icon Name="ThemeDark" />
                                            break;

                                        case "light":
                                            <Icon Name="ThemeLight" />
                                            break;

                                        case "auto":
                                        default:
                                            <Icon Name="ThemeAuto" />
                                            break;
                                    }
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="themeDropdown">
                                    <li>
                                        <a class="dropdown-item" href="javascript:void('@Helpers.Text("ThemeAuto").Replace("'", "")');" @onclick="@(() => Helpers.SetTheme("auto"))">
                                            <Language Tag="ThemeAuto" IncludeIcon="true" />
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="javascript:void('@Helpers.Text("ThemeLight").Replace("'", "")');" @onclick="@(() => Helpers.SetTheme("light"))">
                                            <Language Tag="ThemeLight" IncludeIcon="true" />
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" href="javascript:void('@Helpers.Text("ThemeDark").Replace("'", "")');" @onclick="@(() => Helpers.SetTheme("dark"))">
                                            <Language Tag="ThemeDark" IncludeIcon="true" />
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" data-bs-toggle="offcanvas" href="#offcanvasUserMenu" role="button" aria-controls="offcanvasUserMenu" aria-labelledby="offcanvas-icon" title="@Helpers.Text("InfoMenu")">
                                @if (Model.LoggedIn) {
                                    @if (!String.IsNullOrWhiteSpace(Helpers.UserAvatarUrl)) {
                                        <img class="user-menu-icon" src="@Helpers.UserAvatarUrl" alt="@Helpers.Text("Info")" aria-label="@Helpers.Text("Info")" id="offcanvas-icon" />
                                    } else {
                                        <Icon Name="User" Title="@Helpers.Text("Info")" Id="offcanvas-icon" />
                                    }
                                } else {
                                    <Icon Name="Info" Title="@Helpers.Text("Info")" Id="offcanvas-icon" />
                                }
                            </a>
                        </li>
                    </ul>
                </form>
            </div>
        </div>
    </nav>
</header>

@code {
    /// <summary>
    /// This app uses the nested navigation menu. Set false to fall back to the
    /// default single-level NavigationMenu.
    /// </summary>
    [Parameter] public bool Enabled { get; set; } = true;

    [Parameter] public bool Loading { get; set; }

    public void Dispose()
    {
        Model.OnChange -= StateHasChanged;
    }

    protected override void OnInitialized()
    {
        Model.OnChange += StateHasChanged;
    }

    // Renders one top-level entry: a plain nav link when it has no children, or
    // a dropdown whose panel is the recursive accordion tree when it does.
    protected RenderFragment RenderRootItem(DataObjects.MenuItem item, bool forceActive = false) => __builder =>
    {
        var itemClass = "nav-link";

        if (forceActive || item.PageNames.Contains(Model.View, StringComparer.CurrentCultureIgnoreCase)) {
            itemClass += " active";
        }

        if (item.AppAdminOnly) {
            itemClass += " app-admin-only";
        }

        if (item.Children != null && item.Children.Any()) {
            bool nested = item.Children.Any(x => x.Children != null && x.Children.Any());

            <li class="nav-item dropdown">
                <a class="@itemClass dropdown-toggle"
                   data-bs-toggle="dropdown"
                   data-bs-auto-close="@(nested ? "outside" : "true")"
                   href="#"
                   role="button"
                   aria-expanded="false">
                    @if (!String.IsNullOrWhiteSpace(item.Icon)) {
                        <Icon Name="@item.Icon" />
                    }
                    <span class="icon-text">
                        @((MarkupString)item.Title)
                    </span>
                </a>
                <ul class="dropdown-menu @(nested ? "nav-nested-menu p-0" : "")">
                    @{
                        var orderedChildren = item.Children.OrderBy(x => x.SortOrder).ThenBy(x => x.Title).ToList();
                    }
                    @for (int childIndex = 0; childIndex < orderedChildren.Count; childIndex++) {
                        @RenderMenuChild(orderedChildren[childIndex], 1, NavElementId(item.Title) + "-" + childIndex.ToString())
                    }
                </ul>
            </li>
        } else {
            <li class="nav-item">
                @if (item.OnClick != null) {
                    string href = !String.IsNullOrWhiteSpace(item.AriaLabel) ? item.AriaLabel :
                        !String.IsNullOrWhiteSpace(item.Title) ? item.Title : Guid.NewGuid().ToString();

                    <a class="@itemClass"
                       href="javascript:void('@href.Replace("'", "")');"
                       title="@item.TooltipTitle"
                       aria-label="@item.AriaLabel"
                       @onclick="@(() => item.OnClick.DynamicInvoke())">
                        @if (!String.IsNullOrWhiteSpace(item.Icon)) {
                            <Icon Name="@item.Icon" />
                        }
                        <span class="icon-text">
                            @((MarkupString)item.Title)
                        </span>
                    </a>
                } else {
                    <a class="@itemClass"
                       title="@item.TooltipTitle"
                       aria-label="@item.AriaLabel"
                       href="@item.url">
                        @if (!String.IsNullOrWhiteSpace(item.Icon)) {
                            <Icon Name="@item.Icon" />
                        }
                        <span class="icon-text">
                            @((MarkupString)item.Title)
                        </span>
                    </a>
                }
            </li>
        }
    };

    // One child at any depth: a branch renders as a Bootstrap accordion (the
    // collapse data API opens it and maintains aria-expanded); a leaf renders as
    // the classic .dropdown-item link. Ids derive from the title path because
    // Helpers.MenuItems rebuilds new item instances on every access.
    protected RenderFragment RenderMenuChild(DataObjects.MenuItem child, int depth, string path) => __builder =>
    {
        if (child.Children != null && child.Children.Any()) {
            string bodyId = "navapp-" + path;
            string heading = "h" + Math.Min(depth + 1, 6).ToString();

            <li>
                <div class="accordion accordion-flush">
                    <div class="accordion-item">
                        @((MarkupString)$"<{heading} class=\"accordion-header\">")
                            <button class="accordion-button collapsed py-2" type="button"
                                    data-bs-toggle="collapse" data-bs-target="@("#" + bodyId)"
                                    aria-expanded="false" aria-controls="@bodyId">
                                @if (!String.IsNullOrWhiteSpace(child.Icon)) {
                                    <Icon Name="@child.Icon" />
                                }
                                <span class="icon-text">
                                    @((MarkupString)child.Title)
                                </span>
                            </button>
                        @((MarkupString)$"</{heading}>")

                        <div class="accordion-collapse collapse" id="@bodyId">
                            <div class="accordion-body p-0 ps-3">
                                <ul class="list-unstyled mb-0">
                                    @{
                                        var orderedGrandchildren = child.Children.OrderBy(x => x.SortOrder).ThenBy(x => x.Title).ToList();
                                    }
                                    @for (int i = 0; i < orderedGrandchildren.Count; i++) {
                                        @RenderMenuChild(orderedGrandchildren[i], depth + 1, path + "-" + i.ToString())
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </li>
        } else if (child.OnClick != null) {
            string href = !String.IsNullOrWhiteSpace(child.AriaLabel) ? child.AriaLabel :
                !String.IsNullOrWhiteSpace(child.Title) ? child.Title : Guid.NewGuid().ToString();
            <li>
                <a class="dropdown-item"
                   href="javascript:void('@href.Replace("'", "")');"
                   title="@child.TooltipTitle"
                   aria-label="@child.AriaLabel"
                   @onclick="@(async () => { child.OnClick.DynamicInvoke(); await Helpers.HideMenus(); })">
                    @if (!String.IsNullOrWhiteSpace(child.Icon)) {
                        <Icon Name="@child.Icon" />
                    }
                    <span class="icon-text">
                        @((MarkupString)child.Title)
                    </span>
                </a>
            </li>
        } else {
            string dropDownItemClass = "dropdown-item";
            if (child.url.ToLower() == Helpers.CurrentUrl.ToLower()) {
                dropDownItemClass += " active";
            }

            @* Blazor navigation does not reload the page, and nested panels are
               auto-close="outside", so the panel is closed explicitly on click.
               The href still performs the actual navigation. *@
            <li>
                <a class="@dropDownItemClass"
                   href="@child.url"
                   title="@child.TooltipTitle"
                   aria-label="@child.AriaLabel"
                   @onclick="@(async () => await Helpers.HideMenus())">
                    @if (!String.IsNullOrWhiteSpace(child.Icon)) {
                        <Icon Name="@child.Icon" />
                    }
                    <span class="icon-text">
                        @((MarkupString)child.Title)
                    </span>
                </a>
            </li>
        }
    };

    /// <summary>
    /// Reduces a menu title to a safe, deterministic id fragment.
    /// </summary>
    protected string NavElementId(string title)
    {
        var chars = title.Where(Char.IsLetterOrDigit).Take(24).ToArray();
        return chars.Length > 0 ? new string(chars).ToLower() : "item";
    }
}
