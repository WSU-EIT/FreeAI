@using FreeBlazorExtended.SelectFile
@using FreeBlazorExtended.RenderFiles

@if (Variant == "v1") {
<div class="container-fluid py-4">
    <h1>SelectFile - Default</h1>

    <FreeBlazorExtended.SelectFile.SelectFile Files="_v1Files" OnFileSelected="V1HandleSelected" />

    <div class="mt-3 text-muted">Selected: @(_v1SelectedFileName ?? "(none)")</div>
</div>

} else if (Variant == "v2") {
<div class="container-fluid py-4">
    <h1>SelectFile - With Cancel, Refresh, and Loading Toggle</h1>

    <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
        <div class="form-check">
            <input id="forceEmpty" class="form-check-input" type="checkbox" @bind="_v2ForceEmpty" />
            <label class="form-check-label" for="forceEmpty">Force empty</label>
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="V2ReopenPicker">Reopen picker</button>
    </div>

    @if (_v2PickerVisible) {
        <FreeBlazorExtended.SelectFile.SelectFile Files="V2CurrentFiles"
                OnFileSelected="V2HandleSelected"
                ShowCancelButton="true"
                CancelButtonText="Close picker"
                OnCancel="V2HandleCancel"
                ShowRefreshButton="true"
                RefreshButtonText="Reload"
                OnRefresh="V2HandleRefresh"
                Loading="@_v2Loading"
                EmptyText="No files match - try refreshing." />
    } else {
        <div class="alert alert-secondary" role="status">Picker closed.</div>
    }

    <div class="mt-3 text-muted">Selected: @(_v2SelectedFileName ?? "(none)")</div>
</div>

} else if (Variant == "v3") {
<div class="container-fluid py-4">
    <h1>SelectFile - Composed With RenderFiles</h1>

    <h2 class="h5">Available Files</h2>
    <FreeBlazorExtended.SelectFile.SelectFile Files="_v3Available"
            OnFileSelected="V3AddAttachment"
            ShowRefreshButton="true"
            OnRefresh="V3ReloadAvailable" />

    <h2 class="h5 mt-4">Selected Attachments</h2>
    <p class="text-muted">Attachments: @_v3Attachments.Count</p>
    <FreeBlazorExtended.RenderFiles.RenderFiles Files="_v3Attachments" OnDelete="V3RemoveAttachment" UseDeleteConfirmation="true" DeleteText="Remove" />
</div>

}

@code {
    [Parameter] public string Variant { get; set; } = "v1";

    // ---- v1 ----
    private readonly List<FileItem> _v1Files = V1BuildFiles();
    private string? _v1SelectedFileName;

    private static List<FileItem> V1BuildFiles()
    {
        return new List<FileItem>
        {
            new() { FileId = Guid.NewGuid(), FileName = "sunrise.png", Extension = ".png", Bytes = 800, RemoteImageUrl = "https://picsum.photos/seed/sf1/300/200" },
            new() { FileId = Guid.NewGuid(), FileName = "forest.jpg", Extension = ".jpg", Bytes = 524288, RemoteImageUrl = "https://picsum.photos/seed/sf2/300/200" },
            new() { FileId = Guid.NewGuid(), FileName = "report.pdf", Extension = ".pdf", Bytes = 2345678, ThumbnailIcon = "fa-solid fa-file-pdf" },
            new() { FileId = Guid.NewGuid(), FileName = "proposal.docx", Extension = ".docx", Bytes = 87400, ThumbnailIcon = "fa-solid fa-file-word" },
        };
    }

    private Task V1HandleSelected(FileItem file)
    {
        _v1SelectedFileName = file.FileName;
        return Task.CompletedTask;
    }

    // ---- v2 ----
    private List<FileItem> _v2Files = V2BuildFiles();
    private bool _v2Loading;
    private bool _v2PickerVisible = true;
    private bool _v2ForceEmpty;
    private string? _v2SelectedFileName;

    private List<FileItem> V2CurrentFiles => _v2ForceEmpty ? new List<FileItem>() : _v2Files;

    private static List<FileItem> V2BuildFiles()
    {
        return new List<FileItem>
        {
            new() { FileId = Guid.NewGuid(), FileName = "gallery.png", Extension = ".png", Bytes = 1100, RemoteImageUrl = "https://picsum.photos/seed/sfv21/300/200" },
            new() { FileId = Guid.NewGuid(), FileName = "sunset.jpg", Extension = ".jpg", Bytes = 610000, RemoteImageUrl = "https://picsum.photos/seed/sfv22/300/200" },
            new() { FileId = Guid.NewGuid(), FileName = "icon.svg", Extension = ".svg", Bytes = 320, Value = V2InlineSvgBytes() },
            new() { FileId = Guid.NewGuid(), FileName = "notes.pdf", Extension = ".pdf", Bytes = 1789000, ThumbnailIcon = "fa-solid fa-file-pdf" },
            new() { FileId = Guid.NewGuid(), FileName = "contract.docx", Extension = ".docx", Bytes = 93400, ThumbnailIcon = "fa-solid fa-file-word" },
        };
    }

    private Task V2HandleCancel()
    {
        _v2PickerVisible = false;
        return Task.CompletedTask;
    }

    private async Task V2HandleRefresh()
    {
        _v2Loading = true;
        await Task.Delay(700);
        _v2Files = V2BuildFiles();
        _v2Loading = false;
    }

    private Task V2HandleSelected(FileItem file)
    {
        _v2SelectedFileName = file.FileName;
        return Task.CompletedTask;
    }

    private static byte[] V2InlineSvgBytes()
    {
        return System.Text.Encoding.UTF8.GetBytes("<svg xmlns='http://www.w3.org/2000/svg' width='120' height='80'><rect width='120' height='80' fill='#0d6efd'/><text x='60' y='46' text-anchor='middle' font-size='18' fill='white'>SVG</text></svg>");
    }

    private void V2ReopenPicker()
    {
        _v2PickerVisible = true;
    }

    // ---- v3 ----
    private List<FileItem> _v3Available = V3BuildAvailableFiles();
    private List<FileItem> _v3Attachments = new();

    private Task V3AddAttachment(FileItem file)
    {
        if (_v3Attachments.Any(item => item.FileId == file.FileId)) {
            return Task.CompletedTask;
        }

        _v3Attachments.Add(V3Clone(file));
        return Task.CompletedTask;
    }

    private static List<FileItem> V3BuildAvailableFiles()
    {
        return new List<FileItem>
        {
            new() { FileId = Guid.NewGuid(), FileName = "cover.png", Extension = ".png", Bytes = 1400, RemoteImageUrl = "https://picsum.photos/seed/av1/300/200" },
            new() { FileId = Guid.NewGuid(), FileName = "scene.jpg", Extension = ".jpg", Bytes = 550000, RemoteImageUrl = "https://picsum.photos/seed/av2/300/200" },
            new() { FileId = Guid.NewGuid(), FileName = "spec-sheet.pdf", Extension = ".pdf", Bytes = 2100000, ThumbnailIcon = "fa-solid fa-file-pdf" },
            new() { FileId = Guid.NewGuid(), FileName = "assets.zip", Extension = ".zip", Bytes = 3180000, ThumbnailIcon = "fa-solid fa-file-zipper" },
            new() { FileId = Guid.NewGuid(), FileName = "proposal.docx", Extension = ".docx", Bytes = 94000, ThumbnailIcon = "fa-solid fa-file-word" },
            new() { FileId = Guid.NewGuid(), FileName = "logo.svg", Extension = ".svg", Bytes = 320, Value = V3InlineSvgBytes() },
        };
    }

    private static FileItem V3Clone(FileItem file)
    {
        return new FileItem
        {
            FileId = file.FileId,
            FileName = file.FileName,
            Extension = file.Extension,
            Bytes = file.Bytes,
            RemoteImageUrl = file.RemoteImageUrl,
            ThumbnailIcon = file.ThumbnailIcon,
            Value = file.Value,
        };
    }

    private static byte[] V3InlineSvgBytes()
    {
        return System.Text.Encoding.UTF8.GetBytes("<svg xmlns='http://www.w3.org/2000/svg' width='120' height='80'><rect width='120' height='80' fill='#198754'/><text x='60' y='46' text-anchor='middle' font-size='18' fill='white'>SVG</text></svg>");
    }

    private Task V3ReloadAvailable()
    {
        _v3Available = V3BuildAvailableFiles();
        return Task.CompletedTask;
    }

    private Task V3RemoveAttachment(FileItem file)
    {
        _v3Attachments = _v3Attachments.Where(item => item.FileId != file.FileId).ToList();
        return Task.CompletedTask;
    }
}
