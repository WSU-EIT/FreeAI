@using FreeBlazorExtended.CommandPalette
@inject NavigationManager NavigationManager

@if (Variant == "v1") {
<div class="container-fluid py-4">
    <h1>Default Command Palette</h1>
    <p class="text-muted">Press Ctrl+K to open the palette and filter this small command list.</p>

    <CommandPalette Commands="_v1Commands" />
</div>

} else if (Variant == "v2") {
<div class="container-fluid py-4">
    <h1>Categorized Command Palette</h1>
    <p class="text-muted">This variant uses Ctrl+J, richer labels, categories, icons, and a larger recent-command history.</p>

    <CommandPalette Commands="_v2Commands" TriggerHotkey="j" PlaceholderText="What do you want to do?" HistorySize="8" />
</div>

} else if (Variant == "v3") {
<div class="container-fluid py-4">
    <h1>Programmatic Command Palette With Action Log</h1>

    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
        <button type="button" class="btn btn-primary btn-sm" @onclick="V3OpenPalette">Open Palette</button>
        <span class="badge bg-secondary">Palette: @(_v3Palette?.IsOpen == true ? "Open" : "Closed")</span>
        <span class="badge @(_v3DarkAccent ? "bg-dark" : "bg-light text-dark border")">Theme Accent: @(_v3DarkAccent ? "Dark" : "Light")</span>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Counter</h2>
                    <div class="display-6 mb-0">@_v3Counter</div>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Action Log</h2>
                    <ul class="small mb-0 ps-3">
                        @foreach (var item in _v3ActionLog) {
                            <li>@item</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <CommandPalette @ref="_v3Palette"
            Commands="_v3Commands"
            TriggerHotkey="k"
            PlaceholderText="Run a command..."
            OnCommandInvoked="V3HandleCommand" />
</div>

}

@code {
    [Parameter] public string Variant { get; set; } = "v1";

    // ---- v1 ----
    private readonly List<CommandPalette.CommandItem> _v1Commands = new()
    {
        new() { Id = "new-file", Label = "New File" },
        new() { Id = "open-file", Label = "Open File" },
        new() { Id = "save", Label = "Save" },
        new() { Id = "close-tab", Label = "Close Tab" },
        new() { Id = "toggle-sidebar", Label = "Toggle Sidebar" },
    };

    // ---- v2 ----
    private readonly List<CommandPalette.CommandItem> _v2Commands = new()
    {
        new() { Id = "new-file", Label = "New File", Category = "File", Icon = "fa-solid fa-file-circle-plus", Description = "Create a new workspace file." },
        new() { Id = "open-file", Label = "Open File", Category = "File", Icon = "fa-solid fa-folder-open", Description = "Open an existing file." },
        new() { Id = "save", Label = "Save", Category = "File", Icon = "fa-solid fa-floppy-disk", Description = "Save the current document." },
        new() { Id = "toggle-sidebar", Label = "Toggle Sidebar", Category = "View", Icon = "fa-solid fa-panels-left" },
        new() { Id = "zen-mode", Label = "Zen Mode", Category = "View", Icon = "fa-solid fa-expand" },
        new() { Id = "goto-dashboard", Label = "Go to Dashboard", Category = "Navigation", Icon = "fa-solid fa-gauge-high", Description = "Jump to the main dashboard." },
        new() { Id = "goto-showcase", Label = "Go to Showcase", Category = "Navigation", Icon = "fa-solid fa-table-cells" },
        new() { Id = "goto-settings", Label = "Open Settings", Category = "Navigation", Icon = "fa-solid fa-gear" },
        new() { Id = "profile", Label = "Profile", Category = "Account", Icon = "fa-solid fa-user" },
        new() { Id = "billing", Label = "Billing", Category = "Account", Icon = "fa-solid fa-credit-card", Description = "Manage subscriptions and invoices." },
        new() { Id = "sign-out", Label = "Sign Out", Category = "Account", Icon = "fa-solid fa-right-from-bracket" },
        new() { Id = "support", Label = "Contact Support", Category = "Account", Icon = "fa-solid fa-life-ring" },
    };

    // ---- v3 ----
    private readonly List<CommandPalette.CommandItem> _v3Commands = new()
    {
        new() { Id = "increment-counter", Label = "Increment Counter", Category = "Actions", Icon = "fa-solid fa-plus", Description = "Add one to the visible counter." },
        new() { Id = "toggle-theme", Label = "Toggle Theme Accent", Category = "Actions", Icon = "fa-solid fa-circle-half-stroke" },
        new() { Id = "clear-log", Label = "Clear Action Log", Category = "Actions", Icon = "fa-solid fa-broom" },
        new() { Id = "goto-showcase", Label = "Go to Showcase", Category = "Navigation", Icon = "fa-solid fa-table-cells" },
        new() { Id = "goto-catalog", Label = "Go to Catalog", Category = "Navigation", Icon = "fa-solid fa-list" },
        new() { Id = "open-help", Label = "Open Help", Category = "Help", Icon = "fa-solid fa-circle-question" },
    };

    private FreeBlazorExtended.CommandPalette.CommandPalette? _v3Palette;
    private int _v3Counter;
    private bool _v3DarkAccent;
    private List<string> _v3ActionLog = new() { "No actions yet." };

    private Task V3HandleCommand(CommandPalette.CommandItem item)
    {
        if (item.Id == "increment-counter") {
            _v3Counter++;
        } else if (item.Id == "toggle-theme") {
            _v3DarkAccent = !_v3DarkAccent;
        } else if (item.Id == "clear-log") {
            _v3ActionLog.Clear();
        } else if (item.Id == "goto-showcase") {
            NavigationManager.NavigateTo("/showcase");
        } else if (item.Id == "goto-catalog") {
            NavigationManager.NavigateTo("/showcase/catalog");
        }

        _v3ActionLog.Insert(0, $"{DateTime.Now:HH:mm:ss} — {item.Id}");
        if (_v3ActionLog.Count > 10) {
            _v3ActionLog = _v3ActionLog.Take(10).ToList();
        }

        return Task.CompletedTask;
    }

    private void V3OpenPalette()
    {
        _v3Palette?.Open();
        StateHasChanged();
    }
}
