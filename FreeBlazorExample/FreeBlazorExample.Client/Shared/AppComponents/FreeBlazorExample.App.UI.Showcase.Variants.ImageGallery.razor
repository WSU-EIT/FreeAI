    private readonly Dictionary<string, string> _v3Metadata = new()
    {
        ["1"] = "1200x800 — Photo by Alex Carter",
        ["2"] = "1200x800 — Photo by Jamie Lee",
        ["3"] = "1200x800 — Photo by Morgan Shaw",
        ["4"] = "1200x800 — Photo by Riley West",
        ["5"] = "1200x800 — Photo by Dana Cole",
        ["6"] = "1200x800 — Photo by Sam Green",
        ["7"] = "1200x800 — Photo by Robin Diaz",
        ["8"] = "1200x800 — Photo by Casey Frost",
    };

    private ImageGallery.GalleryImage? _v3SelectedImage;
    private List<string> _v3ClickHistory = new() { "No images selected yet." };

    private Task V3HandleImageClick(ImageGallery.GalleryImage image)
    {
        _v3SelectedImage = image;
        if (_v3ClickHistory.Count == 1 && _v3ClickHistory[0] == "No images selected yet.") {
            _v3ClickHistory.Clear();
        }

        _v3ClickHistory.Insert(0, $"{DateTime.Now:HH:mm:ss} — {image.Id}");
        if (_v3ClickHistory.Count > 5) {
            _v3ClickHistory = _v3ClickHistory.Take(5).ToList();
        }

        return Task.CompletedTask;
    }

    private string V3MetadataFor(string id)
    {
        return _v3Metadata.TryGetValue(id, out var value) ? value : "Unknown";
    }
}
