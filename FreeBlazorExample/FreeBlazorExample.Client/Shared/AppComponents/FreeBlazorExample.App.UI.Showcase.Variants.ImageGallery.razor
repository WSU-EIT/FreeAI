@using FreeBlazorExtended.ImageGallery

@if (Variant == "v1") {
<div class="container-fluid py-4">
    <h1>Default Image Gallery</h1>

    <ImageGallery Images="_v1Images" />
</div>

} else if (Variant == "v2") {
<div class="container-fluid py-4">
    <h1>Captioned Photo Gallery</h1>

    <ImageGallery Images="_v2Images" ColumnCount="5" EnableLightbox="true" ThumbnailClass="mb-4" />
</div>

} else if (Variant == "v3") {
<div class="container-fluid py-4">
    <h1>Gallery With Custom Click Handler</h1>

    <div class="row g-4">
        <div class="col-md-8">
            <ImageGallery Images="_v3Images" ColumnCount="4" EnableLightbox="false" OnImageClick="V3HandleImageClick" />
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm sticky-top" style="top: 1rem;">
                <div class="card-body">
                    <h2 class="h5">Selected Photo</h2>
                    @if (_v3SelectedImage is null) {
                        <p class="text-muted mb-0">Click an image to inspect its details here.</p>
                    } else {
                        <img src="@_v3SelectedImage.Url" alt="@_v3SelectedImage.Alt" class="img-fluid rounded mb-3" />
                        <p class="small mb-1"><strong>Caption:</strong> @_v3SelectedImage.Caption</p>
                        <p class="small mb-1"><strong>Category:</strong> @_v3SelectedImage.Category</p>
                        <p class="small mb-0"><strong>Metadata:</strong> @V3MetadataFor(_v3SelectedImage.Id)</p>
                    }
                </div>
            </div>

            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <h2 class="h5">Click History</h2>
                    <ul class="small mb-0 ps-3">
                        @foreach (var entry in _v3ClickHistory) {
                            <li>@entry</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

}

