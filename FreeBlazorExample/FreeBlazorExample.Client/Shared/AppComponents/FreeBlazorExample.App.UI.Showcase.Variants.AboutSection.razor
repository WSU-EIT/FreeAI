@using FreeBlazorExtended.AboutSection
@using FreeBlazorExtended.InfoTip

@if (Variant == "v1") {
<div class="container-fluid py-4">
    <h1>Default About Section</h1>

    <AboutSection>
        <p class="mb-0">
            This is the default AboutSection with the built-in title, icon, and collapsed-on-load behavior.
        </p>
    </AboutSection>
</div>

} else if (Variant == "v2") {
<div class="container-fluid py-4">
    <h1>Configured About Section</h1>

    <AboutSection Title="What is this page?"
                  Subtitle="A demonstration of AboutSection parameters"
                  IconClass="fa-solid fa-graduation-cap"
                  StartExpanded="true">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h2 class="h6">Examples</h2>
                        <p class="small mb-0">Use this pattern to frame a page with context, audience, and implementation notes without overwhelming the first screen.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h2 class="h6">Why</h2>
                        <p class="small mb-0">It keeps important explanatory content close to the UI while still letting the primary experience stay focused and uncluttered.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h2 class="h6">Audience</h2>
                        <p class="small mb-0">Great for product owners, implementers, and reviewers who need quick orientation before interacting with a page.</p>
                    </div>
                </div>
            </div>
        </div>
    </AboutSection>
</div>

} else if (Variant == "v3") {
<div class="container-fluid py-4">
    <h1>Stacked About Sections With Embedded InfoTips</h1>

    <AboutSection Title="Overview"
                  Subtitle="Why this pattern works"
                  IconClass="fa-solid fa-circle-info"
                  StartExpanded="true">
        <p class="mb-0">
            AboutSection is a flexible explanation container for pages that need background context.
            <InfoTip Title="Flexible container"
                     Description="The component simply renders caller-supplied ChildContent inside a collapsible card, so the page decides what the content should be." />
        </p>
    </AboutSection>

    <AboutSection Title="Audience"
                  Subtitle="Who benefits from the extra context"
                  IconClass="fa-solid fa-users"
                  StartExpanded="false">
        <p class="mb-0">
            It helps implementers, reviewers, and business users align on the intent of a page before they start clicking.
            <InfoTip Title="Reviewers"
                     Description="This includes developers, QA, accessibility reviewers, and product owners who need to understand the purpose of the page quickly." />
        </p>
    </AboutSection>

    <AboutSection Title="Tech Stack"
                  Subtitle="Composing components together"
                  IconClass="fa-solid fa-screwdriver-wrench"
                  StartExpanded="false">
        <p class="mb-0">
            This slot can host plain markup or other reusable components like InfoTip.
            <InfoTip Title="Composition"
                     Description="Because ChildContent is just a RenderFragment, nested components work normally inside the expanded body." />
        </p>
    </AboutSection>
</div>

}

@code {
    [Parameter] public string Variant { get; set; } = "v1";


}
