@using FreeBlazorExtended.Timeline

@if (Variant == "v1") {
<div class="container-fluid py-4">
    <h1>Default Timeline</h1>

    <Timeline Events="_v1Events" />
</div>

} else if (Variant == "v2") {
<div class="container-fluid py-4">
    <h1>Order Timeline With Actors</h1>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <Timeline Events="_v2Events"
                    ShowTimestamps="true"
                    ShowConnectorLine="true"
                    TimestampFormat="ddd MMM d - h:mm tt"
                    Class="bg-light p-3 rounded" />
        </div>
    </div>
</div>

} else if (Variant == "v3") {
<div class="container-fluid py-4">
    <h1>Deployment Timeline With Drill-In</h1>

    <div class="row g-4">
        <div class="col-md-7">
            <Timeline Events="_v3Events" TimestampFormat="HH:mm:ss" OnEventClick="V3HandleEventClick" />
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Selected Event</h2>
                    @if (_v3SelectedEvent is null) {
                        <p class="text-muted mb-0">Click any event to inspect its details.</p>
                    } else {
                        <p class="small mb-1"><strong>Id:</strong> @_v3SelectedEvent.Id</p>
                        <p class="small mb-1"><strong>Title:</strong> @_v3SelectedEvent.Title</p>
                        <p class="small mb-1"><strong>Actor:</strong> @(_v3SelectedEvent.Actor ?? "—")</p>
                        <p class="small mb-1"><strong>Description:</strong> @(_v3SelectedEvent.Description ?? "—")</p>
                        <div class="small">@((MarkupString)(_v3SelectedEvent.DetailHtml ?? "<em>No detail html.</em>"))</div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

}

@code {
    [Parameter] public string Variant { get; set; } = "v1";

    // ---- v1 ----
    private readonly List<Timeline.TimelineEvent> _v1Events = new()
    {
        new() { Id = "1", Title = "Order Placed", State = Timeline.TimelineEventState.Completed },
        new() { Id = "2", Title = "Preparing", State = Timeline.TimelineEventState.Completed },
        new() { Id = "3", Title = "Out for Delivery", State = Timeline.TimelineEventState.InProgress },
        new() { Id = "4", Title = "Delivered", State = Timeline.TimelineEventState.Pending },
    };

    // ---- v2 ----
    private readonly List<Timeline.TimelineEvent> _v2Events = new()
    {
        new() { Id = "1", Title = "Order placed", Timestamp = DateTime.Now.AddMinutes(-90), State = Timeline.TimelineEventState.Completed, Actor = "Customer", Description = "The order was submitted successfully." },
        new() { Id = "2", Title = "Kitchen accepted", Timestamp = DateTime.Now.AddMinutes(-75), State = Timeline.TimelineEventState.Completed, Actor = "Kitchen Staff", Description = "Prep started for the order." },
        new() { Id = "3", Title = "Courier assigned", Timestamp = DateTime.Now.AddMinutes(-30), State = Timeline.TimelineEventState.Completed, Actor = "Dispatcher", Description = "Driver Mike picked up the route." },
        new() { Id = "4", Title = "Out for delivery", Timestamp = DateTime.Now.AddMinutes(-10), State = Timeline.TimelineEventState.InProgress, Actor = "Driver Mike", Description = "The package is on the road." },
        new() { Id = "5", Title = "Delivered", Timestamp = default, State = Timeline.TimelineEventState.Pending, Actor = "", Description = "Awaiting final confirmation." },
    };

    // ---- v3 ----
    private readonly List<Timeline.TimelineEvent> _v3Events = new()
    {
        new() { Id = "build", Title = "Build Started", Timestamp = DateTime.Now.AddMinutes(-18), State = Timeline.TimelineEventState.Completed, Actor = "CI", Description = "Compilation started on the release branch." },
        new() { Id = "tests", Title = "Unit Tests", Timestamp = DateTime.Now.AddMinutes(-14), State = Timeline.TimelineEventState.Completed, Actor = "CI", Description = "Unit suite completed.", DetailHtml = "<code>342 passed</code> in <strong>4.2s</strong>" },
        new() { Id = "lint", Title = "Lint", Timestamp = DateTime.Now.AddMinutes(-12), State = Timeline.TimelineEventState.Skipped, Actor = "CI", Description = "Lint was skipped for this hotfix run." },
        new() { Id = "integration", Title = "Integration Tests", Timestamp = DateTime.Now.AddMinutes(-8), State = Timeline.TimelineEventState.Error, Actor = "CI", Description = "Integration tests reported failures.", DetailHtml = "<span class='text-danger'>2 failures detected</span> in checkout and webhook flows." },
        new() { Id = "deploy", Title = "Deploy", Timestamp = DateTime.Now.AddMinutes(-2), State = Timeline.TimelineEventState.InProgress, Actor = "Release Bot", Description = "Deployment is currently running." },
        new() { Id = "verify", Title = "Verify", Timestamp = default, State = Timeline.TimelineEventState.Pending, Actor = "Ops", Description = "Awaiting smoke verification." },
    };

    private Timeline.TimelineEvent? _v3SelectedEvent;

    private Task V3HandleEventClick(Timeline.TimelineEvent evt)
    {
        _v3SelectedEvent = evt;
        return Task.CompletedTask;
    }
}
