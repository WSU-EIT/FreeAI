<div class="col">
    <div class="card @CardClass h-100 cursor-pointer"
            tabindex="0"
            role="link"
            aria-label="View details for agent @Agent.Name, status @Agent.Status"
            @onclick="@(() => OnView.InvokeAsync(Agent.AgentId))"
            @onkeydown="@(e => { if (e.Key == "Enter" || e.Key == " ") OnView.InvokeAsync(Agent.AgentId); })">
        <div class="card-body p-3">
            <div class="d-flex justify-content-between align-items-start mb-2">
                <h6 class="card-title mb-0 text-truncate" title="@Agent.Name">@Agent.Name</h6>
                <span class="badge @AppAgentStatus.GetStatusBadgeClass(Agent.Status)" aria-label="Status: @Agent.Status">@Agent.Status</span>
            </div>
            <div class="small text-muted mb-2">
                <div><Icon Name="Computer" /> @Agent.Hostname</div>
                <div><Icon Name="Settings" /> @Agent.OperatingSystem</div>
            </div>
            @if (Heartbeat != null) {
                var hb = Heartbeat!;
                <div class="mb-1">
                    <div class="d-flex justify-content-between small">
                        <span>CPU</span>
                        <span>@hb.CpuPercent.ToString("F1")%</span>
                    </div>
                    <div class="progress metric-bar" role="progressbar"
                            aria-label="CPU usage" aria-valuenow="@((int)hb.CpuPercent)"
                            aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar @AppAgentStatus.GetMetricClass(hb.CpuPercent, AppAgentStatus.CpuWarn, AppAgentStatus.CpuError)"
                                style="width: @hb.CpuPercent.ToString("F0")%"></div>
                    </div>
                </div>
                <div class="mb-1">
                    <div class="d-flex justify-content-between small">
                        <span>MEM</span>
                        <span>@hb.MemoryPercent.ToString("F1")%</span>
                    </div>
                    <div class="progress metric-bar" role="progressbar"
                            aria-label="Memory usage" aria-valuenow="@((int)hb.MemoryPercent)"
                            aria-valuemin="0" aria-valuemax="100">
                        <div class="progress-bar @AppAgentStatus.GetMetricClass(hb.MemoryPercent, AppAgentStatus.MemoryWarn, AppAgentStatus.MemoryError)"
                                style="width: @hb.MemoryPercent.ToString("F0")%"></div>
                    </div>
                </div>
                @if (Disks != null) {
                    @foreach (var disk in Disks) {
                        <div class="mb-1">
                            <div class="d-flex justify-content-between small">
                                <span>DISK @disk.Drive</span>
                                <span>@disk.Percent.ToString("F1")%</span>
                            </div>
                            <div class="progress metric-bar" role="progressbar"
                                    aria-label="Disk @disk.Drive usage" aria-valuenow="@((int)disk.Percent)"
                                    aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar @AppAgentStatus.GetMetricClass(disk.Percent, AppAgentStatus.DiskWarn, AppAgentStatus.DiskError)"
                                        style="width: @disk.Percent.ToString("F0")%"></div>
                            </div>
                        </div>
                    }
                }
            }
            @if (Agent.LastHeartbeat.HasValue) {
                <div class="small text-muted mt-2">
                    <Language Tag="LastHeartbeat" />: <time datetime="@Agent.LastHeartbeat.Value.ToString("o")">@Agent.LastHeartbeat.Value.ToString("g")</time>
                </div>
            }
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DataObjects.Agent Agent { get; set; } = default!;

    /// <summary>The agent's latest heartbeat, when it has reported one.</summary>
    [Parameter] public DataObjects.AgentHeartbeat? Heartbeat { get; set; }

    /// <summary>The disks from the latest heartbeat, when it reported any.</summary>
    [Parameter] public List<DataObjects.DiskMetric>? Disks { get; set; }

    /// <summary>True for a few seconds after a live update, to flash the card.</summary>
    [Parameter] public bool RecentlyUpdated { get; set; }

    [Parameter] public EventCallback<Guid> OnView { get; set; }

    protected string CardClass {
        get {
            var cardClass = "agent-card agent-" + AppAgentStatus.GetWorstStatus(Agent, Heartbeat, Disks).ToLower();
            if (RecentlyUpdated) {
                cardClass += " agent-card-updated";
            }
            return cardClass;
        }
    }
}
