<div class="d-flex flex-wrap gap-2 mb-3">
    <a href="@Helpers.BuildUrl("Examples/Dashboard")" class="btn btn-primary btn-lg">
        <i class="fa-solid fa-grid-2 me-2"></i>Examples Dashboard
    </a>
</div>

<div class="row row-cols-1 row-cols-md-3 row-cols-lg-5 g-3 mb-4">
    <div class="col">
        <a href="@Helpers.BuildUrl("Examples/Dashboard")" class="text-decoration-none">
            <div class="card h-100 shadow-sm border-0 text-center py-3">
                <div class="card-body">
                    <i class="fa-solid fa-table-columns fa-2x text-dark mb-2"></i>
                    <h6 class="mb-0">Dashboard & Data</h6>
                    <span class="small text-muted">Tables, search, cards</span>
                </div>
            </div>
        </a>
    </div>
    <div class="col">
        <a href="@Helpers.BuildUrl("Examples/FileDemo")" class="text-decoration-none">
            <div class="card h-100 shadow-sm border-0 text-center py-3">
                <div class="card-body">
                    <i class="fa-solid fa-file-arrow-up fa-2x text-success mb-2"></i>
                    <h6 class="mb-0">Files & Media</h6>
                    <span class="small text-muted">Upload, gallery, signatures</span>
                </div>
            </div>
        </a>
    </div>
    <div class="col">
        <a href="@Helpers.BuildUrl("Examples/BootstrapShowcase")" class="text-decoration-none">
            <div class="card h-100 shadow-sm border-0 text-center py-3">
                <div class="card-body">
                    <i class="fa-solid fa-palette fa-2x text-primary mb-2"></i>
                    <h6 class="mb-0">UI Components</h6>
                    <span class="small text-muted">Bootstrap, kanban, chat</span>
                </div>
            </div>
        </a>
    </div>
    <div class="col">
        <a href="@Helpers.BuildUrl("Examples/ChartsDashboard")" class="text-decoration-none">
            <div class="card h-100 shadow-sm border-0 text-center py-3">
                <div class="card-body">
                    <i class="fa-solid fa-chart-pie fa-2x text-warning mb-2"></i>
                    <h6 class="mb-0">Charts & Viz</h6>
                    <span class="small text-muted">Highcharts, network graphs</span>
                </div>
            </div>
        </a>
    </div>
    <div class="col">
        <a href="@Helpers.BuildUrl("Examples/CodeEditor")" class="text-decoration-none">
            <div class="card h-100 shadow-sm border-0 text-center py-3">
                <div class="card-body">
                    <i class="fa-solid fa-code fa-2x text-danger mb-2"></i>
                    <h6 class="mb-0">Code & Real-Time</h6>
                    <span class="small text-muted">Monaco, SignalR, timers</span>
                </div>
            </div>
        </a>
    </div>
</div>
