        @if (Active) {
            <div id="tab-layout" role="tabpanel" aria-labelledby="tabs-heading">

            @* Accordion / Collapsible Sections *@
            <div class="mb-4">
                <h6>Accordion / Collapsible Sections
                    <FreeExamples_App_UI_InfoTip Title="Accordion"
                            Description="An accordion is a list of collapsible sections — click a header to expand its content, click again to collapse. Only one section is open at a time. This saves vertical space when you have lots of content. The expand/collapse is done by toggling an _openAccordion variable."
                            Code="@_codeAccordion" />
                </h6>
                <p class="small text-muted">Bootstrap accordion for expandable content sections.</p>
                <div class="accordion" id="demoAccordion">
                    @for (int i = 0; i < _accordionItems.Count; i++) {
                        var idx = i;
                        var item = _accordionItems[i];
                        var isOpen = _openAccordion == idx;
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button @(!isOpen ? "collapsed" : "")" type="button"
                                        @onclick="@(() => _openAccordion = isOpen ? -1 : idx)"
                                        aria-expanded="@isOpen"
                                        aria-controls="accordion-@idx">
                                    <i class="@item.Icon me-2" aria-hidden="true"></i> @item.Title
                                </button>
                            </h2>
                            @if (isOpen) {
                                <div id="accordion-@idx" class="accordion-collapse collapse show">
                                    <div class="accordion-body">@item.Content</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            @* Card / Table View Toggle — FreeCICD ViewControls pattern *@
            <div class="mb-4">
                <h6>Card / Table View Toggle
                    <FreeExamples_App_UI_InfoTip Title="View Toggle"
                            Description="These buttons let you switch between two ways of viewing the same data: as visual cards or as a compact table. The _viewMode variable controls which is rendered. Both views show the same data — just laid out differently. Card view is scannable; table view is dense and sortable."
                            Code="@_codeViewToggle" />
                </h6>
                <p class="small text-muted">Switch between card and table views. Pattern from FreeCICD Pipeline Dashboard.</p>
                <div class="btn-group mb-3" role="group" aria-label="View mode">
                    <button type="button" class="btn @(_viewMode == "card" ? "btn-primary" : "btn-outline-primary")"
                            @onclick="@(() => _viewMode = "card")">
                        <i class="fa fa-th-large me-1" aria-hidden="true"></i> Cards
                    </button>
                    <button type="button" class="btn @(_viewMode == "table" ? "btn-primary" : "btn-outline-primary")"
                            @onclick="@(() => _viewMode = "table")">
                        <i class="fa fa-list me-1" aria-hidden="true"></i> Table
                    </button>
                </div>

                @if (_viewMode == "card") {
                    <div class="row row-cols-1 row-cols-md-3 g-2">
                        @foreach (var item in Items.Take(3)) {
                            <div class="col">
                                <div class="card border-0 shadow-sm">
                                    <div class="card-body py-2">
                                        <h6 class="card-title mb-1">@item.Name</h6>
                                        <div class="small text-muted">@item.Category</div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                } else {
                    <div class="table-responsive">
                        <table class="table table-striped table-sm" aria-label="Sample items">
                            <thead class="table-dark">
                                <tr>
                                    <th scope="col">Name</th>
                                    <th scope="col">Category</th>
                                    <th scope="col">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Items.Take(3)) {
                                    <tr>
                                        <td>@item.Name</td>
                                        <td>@item.Category</td>
                                        <td><span class="badge @FreeExamples.Client.Pages.App.FreeExamples_App_Pages_BootstrapShowcase.GetBadge(item.Status)">@item.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            @* Progress Bars *@
            <div class="mb-4">
                <h6>Progress Bars</h6>
                <p class="small text-muted">Various progress bar styles for showing completion status.</p>
                <div class="d-flex flex-column gap-3" style="max-width: 500px;">
                    <div>
                        <div class="d-flex justify-content-between small mb-1">
                            <span>Build Pipeline</span>
                            <span>75%</span>
                        </div>
                        <div class="progress" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100" aria-label="Build pipeline progress">
                            <div class="progress-bar bg-primary" style="width: 75%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between small mb-1">
                            <span>Test Coverage</span>
                            <span>42%</span>
                        </div>
                        <div class="progress" role="progressbar" aria-valuenow="42" aria-valuemin="0" aria-valuemax="100" aria-label="Test coverage progress">
                            <div class="progress-bar bg-warning" style="width: 42%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between small mb-1">
                            <span>Deployment</span>
                            <span>100%</span>
                        </div>
                        <div class="progress" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" aria-label="Deployment progress">
                            <div class="progress-bar bg-success" style="width: 100%"></div>
                        </div>
                    </div>
                    <div>
                        <div class="small mb-1">Striped + Animated</div>
                        <div class="progress" role="progressbar" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100" aria-label="Animated progress">
                            <div class="progress-bar progress-bar-striped progress-bar-animated bg-info" style="width: 60%"></div>
                        </div>
                    </div>
                </div>
            </div>

            </div>
        }

@code {
    [Parameter] public bool Active { get; set; }

    [Parameter] public List<DataObjects.SampleItem> Items { get; set; } = new();

    private string _codeAccordion = "@onclick=\"@(() => _openAccordion = isOpen ? -1 : idx)\"";
    private string _codeViewToggle = "<button class=\"btn @(_viewMode == \"card\" ? \"btn-primary\" : \"btn-outline-primary\")\" @onclick=\"...\">Cards</button>";

    private string _viewMode = "card";
    private int _openAccordion = 0;
    private List<AccordionItem> _accordionItems = new() {
        new("fa fa-cog", "Configuration", "Application settings and environment configuration. Use appsettings.json for environment-specific values and user secrets for sensitive data."),
        new("fa fa-database", "Database", "Entity Framework Core with SQL Server. Migrations are auto-applied on startup. Use the DataAccess layer for all database operations."),
        new("fa fa-shield", "Security", "Authentication via cookie-based login with optional SSO providers. Role-based authorization with tenant isolation."),
    };

    private record AccordionItem(string Icon, string Title, string Content);
}
