@* FreeGLBA.App.UI.StatTile.razor - A centered summary number with its label, in its own grid column (GLBA Dashboard). *@

<div class="@ColumnClass">
    <div class="@(("card shadow-sm h-100 " + BorderClass).Trim())">
        <div class="card-body text-center py-3">
            <h2 class="mb-0 @ColorClass">@Value</h2>
            <p class="text-muted mb-0 small">@Label</p>
        </div>
    </div>
</div>

@code {
    /// <summary>Optional border colour class for the card, e.g. border-info.</summary>
    [Parameter] public string BorderClass { get; set; } = "";

    /// <summary>The value's text colour, e.g. text-primary.</summary>
    [Parameter] public string ColorClass { get; set; } = "text-primary";

    /// <summary>The grid column class.</summary>
    [Parameter] public string ColumnClass { get; set; } = "col-lg-3 col-md-4 col-6 mb-3";

    [Parameter] public string Label { get; set; } = "";

    [Parameter] public string? Value { get; set; }
}
