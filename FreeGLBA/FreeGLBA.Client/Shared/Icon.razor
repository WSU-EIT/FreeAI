@implements IDisposable
@{
    if (!String.IsNullOrWhiteSpace(Name)) {
        string iconItem = String.Empty;
        string? elementId = !String.IsNullOrWhiteSpace(Id) ? Id : null;
        string? title = null;
        string source = String.Empty;
        string svg = String.Empty;

        if (!String.IsNullOrWhiteSpace(Title)) {
            title = Helpers.Text(Title);

            if (title.ToLower() == Title.ToLower()) {
                title = Title;
            }
        }

        KeyValuePair<string, List<string>> icon = new KeyValuePair<string, List<string>>();

        icon = Helpers.AppIcons.FirstOrDefault(x => x.Value.Contains(Name.Trim(), StringComparer.InvariantCultureIgnoreCase));
        if (String.IsNullOrWhiteSpace(icon.Key)) {
            icon = Helpers.Icons.FirstOrDefault(x => x.Value.Contains(Name.Trim(), StringComparer.InvariantCultureIgnoreCase));
        }

        if (!String.IsNullOrWhiteSpace(icon.Key)) {
            string key = icon.Key;

            if (key.ToLower().StartsWith("google:")) {
                source = "google";
                iconItem = key.Substring(7);
            } else if (key.ToLower().StartsWith("fa:")) {
                source = "fa";
                iconItem = key.Substring(3);
            } else if (key.ToLower().StartsWith("svg:")) {
                source = "svg";
                svg = Helpers.Icon(Name, true);
            }
        }

        switch (source) {
            case "google":
                if (!String.IsNullOrWhiteSpace(iconItem)) {
                    <i class="icon icon-google material-symbols-outlined" alt="@title" aria-label="@title" id="@elementId">@iconItem</i>
                }
                break;

            case "fa":
                if (!String.IsNullOrWhiteSpace(iconItem)) {
                    <i class="icon icon-fa @iconItem" alt="@title" aria-label="@title" id="@elementId"></i>
                }
                break;

            case "svg":
                if (!String.IsNullOrWhiteSpace(svg)) {
                    @((MarkupString)svg)
                }
                break;
        }
    }
}
@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string? Name { get; set; }
    [Parameter] public string? Title { get; set; }

    public void Dispose()
    {
    }
}